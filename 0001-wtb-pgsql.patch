+def _env_or_default(env_var: str, default: str, use_env: bool) -> str:
+    """
+    Read an environment variable, falling back to *default*.
+
+    Unlike ``os.getenv(env_var, "")``, this function treats an **unset**
+    variable the same as a variable set to an empty string — both cases
+    return *default*.  This ensures that the hard-coded default password
+    (``_DEFAULT_DB_PASSWORD``) is used when the caller hasn't explicitly
