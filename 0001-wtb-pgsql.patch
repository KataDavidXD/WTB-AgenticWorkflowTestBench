+def create_all_tables(conn) -> None:
+    """
+    Create all WTB tables in a PostgreSQL database.
+
+    Equivalent to the former ``Base.metadata.create_all(engine)``.
+
+    Args:
+        conn: A psycopg2 connection (or any object with a cursor/execute).
+    """
+    with conn.cursor() as cur:
+        cur.execute(CREATE_ALL_TABLES_SQL)
+    conn.commit()
+
+
+def drop_all_tables(conn) -> None:
+    """
+    Drop all WTB tables (for testing / reset).
+
+    Tables are dropped in reverse-dependency order to respect foreign keys.
+
+    Args:
+        conn: A psycopg2 connection.
+    """
+    tables = [
+        "wtb_audit_logs",
+        "wtb_outbox",
+        "wtb_node_boundaries",
+        "wtb_evaluation_results",
+        "wtb_batch_tests",
+        "wtb_node_variants",
+        "wtb_executions",
+        "wtb_workflows",
+    ]
+    with conn.cursor() as cur:
+        for table in tables:
+            cur.execute(f"DROP TABLE IF EXISTS {table} CASCADE;")
+    conn.commit()
+
